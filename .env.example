# automagic Multi-Provider Automation Configuration
# Edit these values with your provider credentials and preferences

# =============================================================================
# Provider Configuration (REQUIRED - choose one approach)
# =============================================================================

# Option 1: Generic Provider Configuration (Recommended)
PROVIDER_TYPE=gitlab
PROVIDER_URL=https://gitlab.com
PROVIDER_TOKEN=your-token-here
PROVIDER_USERNAME=your-username

# Option 2: GitLab-Specific Configuration (will auto-detect as gitlab)
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-your-personal-access-token-here
GITLAB_USERNAME=your-gitlab-username

# Option 3: GitHub-Specific Configuration (will auto-detect as github)
GITHUB_URL=https://api.github.com
GITHUB_TOKEN=ghp_your-personal-access-token-here
GITHUB_USERNAME=your-github-username

# =============================================================================
# Claude AI Configuration (REQUIRED)
# =============================================================================
CLAUDE_COMMAND=claude
CLAUDE_FLAGS=--dangerously-skip-permissions --output-format stream-json --verbose

# =============================================================================
# Project Configuration (Optional - can be set via interactive mode)
# =============================================================================
DEFAULT_PROJECT_PATH=

# =============================================================================
# Daemon Configuration (Optional)
# =============================================================================
DAEMON_INTERVAL=30
CLAUDE_LABEL=claude
PROCESS_LABEL=picked_up_by_claude
REVIEW_LABEL=waiting_human_review

# =============================================================================
# Configuration Notes:
# =============================================================================
# 1. Provider Selection Priority (choose ONE approach):
#    a) Set PROVIDER_TYPE explicitly ("gitlab" or "github")
#    b) Auto-detection based on tokens:
#       - If GITHUB_TOKEN is set → GitHub provider
#       - If GITLAB_TOKEN is set → GitLab provider
#       - PROVIDER_TYPE overrides auto-detection
#
# 2. Token Requirements:
#    - GitLab: Personal Access Token with 'api' scope
#      Format: glpat-xxxxxxxxxxxxxxxxxxxx
#    - GitHub: Personal Access Token with 'repo' and 'issues' scopes  
#      Format: ghp_xxxxxxxxxxxxxxxxxxxx
#
# 3. URL Configuration:
#    - GitLab.com: https://gitlab.com
#    - GitHub.com: https://api.github.com
#    - Self-hosted GitLab: https://your-gitlab-instance.com
#    - GitHub Enterprise: https://api.your-github-enterprise.com
#
# 4. Project Path Format:
#    - GitLab: "namespace/project-name" (e.g., "mycompany/backend-api")
#    - GitHub: "owner/repository-name" (e.g., "octocat/Hello-World")
#
# 5. Usage Examples:
#    # For GitLab only:
#    - Comment out or remove GITHUB_* variables
#    - Set GITLAB_* variables OR use PROVIDER_* with type=gitlab
#    
#    # For GitHub only:  
#    - Comment out or remove GITLAB_* variables
#    - Set GITHUB_* variables OR use PROVIDER_* with type=github
#    
#    # For explicit control:
#    - Set PROVIDER_TYPE to override auto-detection
#    - Use PROVIDER_* variables for cleaner configuration